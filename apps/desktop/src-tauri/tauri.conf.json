{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Routizen",
  "version": "0.1.0",
  "identifier": "app.routizen.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev -w @routizen/web",
    "beforeBuildCommand": "npm run build -w @routizen/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Routizen",
        "width": 420,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "루틴 형성을 돕는 스케줄링 앱",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "notification": {},
    "deep-link": {
      "desktop": {
        "schemes": ["routizen"]
      }
    }
  }
}
